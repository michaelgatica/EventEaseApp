@page "/session"
@implements IDisposable

@inject UserSessionService SessionService

<PageTitle>Session Tracker | EventEase</PageTitle>

<h1>User Session Tracker</h1>

<section class="card">
    <h2>Current Session</h2>

    <p><strong>User:</strong> @(SessionService.CurrentUserName ?? "No user registered yet")</p>
    <p><strong>Email:</strong> @(SessionService.CurrentUserEmail ?? "Not available")</p>
    <p><strong>Last Viewed Event:</strong> @(SessionService.LastViewedEventName ?? "No event viewed yet")</p>
    <p><strong>Registration Count:</strong> @SessionService.RegistrationCount</p>

    <button class="secondary-button" type="button" @onclick="ClearSession">Clear Session</button>
</section>

@code {
    protected override void OnInitialized()
    {
        SessionService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ClearSession()
    {
        SessionService.ClearSession();
    }

    public void Dispose()
    {
        SessionService.OnChange -= HandleStateChanged;
    }
}
